APP_NAME=Offer Agent
APP_ENV=development
JWT_SECRET=-1cY5cSK5OLORJAJXEvnWPQXHQN8N-HYeQVqILmxkUg
JWT_EXPIRE_MINUTES=720
DEFAULT_INTERVIEW_QUOTA=5
DATABASE_PATH=./data/offer_agent.db
CORS_ORIGINS=http://localhost:5173
LOG_FILE_PATH=./logs/offer_agent.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_PAYLOAD_MAX_CHARS=0

# ------------------------------------------------------------------------------
# LLM config
# ------------------------------------------------------------------------------
# Global model switch used by resume parsing, interview question generation,
# follow-up generation, and evaluation summary.
#
# Supported providers:
# - mock
# - openai
# - anthropic / claude / claude_code
# - volcengine / ark
#
# LLM_MODEL is the unified model name field for all providers.
# Base URL fields are optional. Only fill them when you are using a proxy,
# gateway, vendor-compatible endpoint, or private deployment.
# LLM_TIMEOUT_SECONDS controls the max waiting time for a single model request.
# ------------------------------------------------------------------------------

# Default local debug mode: no real model call
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# OpenAI or OpenAI-compatible gateway
# Example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=<YOUR_OPENAI_KEY>
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# If you are using a compatible gateway from a cloud vendor, keep
# LLM_PROVIDER=openai and replace OPENAI_BASE_URL + LLM_MODEL accordingly.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# RAG config for interview planning
# ------------------------------------------------------------------------------
# When enabled, the planning stage will retrieve role-specific knowledge from a
# Milvus Lite collection before generating interview questions.
#
# Steps:
# 1. Fill the settings below.
# 2. Prepare role knowledge markdown files under backend/knowledge/roles/.
# 3. Run: python3 scripts/index_role_knowledge.py
# ------------------------------------------------------------------------------
RAG_ENABLED=false
RAG_COLLECTION_NAME=role_knowledge
RAG_TOP_K=4
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=hash-embedding-v1
RAG_EMBEDDING_DIMENSION=256
RAG_KNOWLEDGE_DIR=./knowledge
MILVUS_LITE_DB_PATH=./data/milvus_lite.db

# ------------------------------------------------------------------------------
# Claude / Anthropic or Anthropic-compatible gateway
# Example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_KEY>
# ANTHROPIC_BASE_URL=https://api.anthropic.com
#
# If your cloud vendor exposes a Claude-compatible endpoint, fill
# ANTHROPIC_BASE_URL with that gateway address.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ------------------------------------------------------------------------------
# Volcengine Ark / Doubao
# Example:
# LLM_PROVIDER=volcengine
# LLM_MODEL=doubao-seed-1-6-flash-250715
# VOLCENGINE_API_KEY=<YOUR_VOLCENGINE_KEY>
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ------------------------------------------------------------------------------
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
