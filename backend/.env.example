# 应用名称
APP_NAME=Offer Agent
# 运行环境：development / production
APP_ENV=development
# JWT 签名密钥（生产环境请更换为随机长字符串）
JWT_SECRET=请替换为随机密钥
# 登录 Token 有效期（分钟）
JWT_EXPIRE_MINUTES=720
# 新用户默认面试次数
DEFAULT_INTERVIEW_QUOTA=5
# SQLite 数据库文件路径（相对 backend 目录）
DATABASE_PATH=./data/offer_agent.db
# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173
# 应用日志文件路径
LOG_FILE_PATH=./logs/offer_agent.log
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 单个日志文件最大字节数（当前约 10MB）
LOG_MAX_BYTES=10485760
# 日志轮转保留份数
LOG_BACKUP_COUNT=5
# 日志中单条 payload 最大字符数，0 表示不截断
LOG_PAYLOAD_MAX_CHARS=0

# 大模型 — 详见 LLM_README.md
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_SECONDS=300
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# RAG — 详见 RAG_README.md
RAG_ENABLED=false
RAG_COLLECTION_NAME=role_knowledge
RAG_TOP_K=4
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=hash-embedding-v1
RAG_EMBEDDING_DIMENSION=256
RAG_KNOWLEDGE_DIR=./knowledge
MILVUS_LITE_DB_PATH=./data/milvus_lite.db
