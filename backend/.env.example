# 应用名称
APP_NAME=Offer Agent
# 运行环境：development / production
APP_ENV=development
# JWT 签名密钥（生产环境请更换为随机长字符串）
JWT_SECRET=请替换为随机密钥
# 登录 Token 有效期（分钟）
JWT_EXPIRE_MINUTES=720
# 新用户默认面试次数
DEFAULT_INTERVIEW_QUOTA=5
# SQLite 数据库文件路径（相对 backend 目录）
DATABASE_PATH=./data/offer_agent.db
# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173
# 应用日志文件路径
LOG_FILE_PATH=./logs/offer_agent.log
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 单个日志文件最大字节数（当前约 10MB）
LOG_MAX_BYTES=10485760
# 日志轮转保留份数
LOG_BACKUP_COUNT=5
# 日志中单条 payload 最大字符数，0 表示不截断
LOG_PAYLOAD_MAX_CHARS=0

# ------------------------------------------------------------------------------
# 大模型配置
# ------------------------------------------------------------------------------
# 全局模型开关，影响：简历解析、面试出题、追问、评价总结。
#
# 支持的 LLM_PROVIDER：
# - mock          本地规则，不调用真实模型（适合离线调试）
# - openai        OpenAI 或 OpenAI 兼容网关
# - anthropic     Claude / Anthropic 或兼容网关（claude、claude_code 同此路径）
# - volcengine    火山方舟 / 豆包（ark、volc、huoshan 同此路径）
#
# LLM_MODEL：各厂商统一的模型名字段，需与网关文档一致。
# *_BASE_URL：可选；使用代理、云厂商网关或私有化部署时填写。
# LLM_TIMEOUT_SECONDS：单次模型请求最长等待时间（秒）。
# ------------------------------------------------------------------------------

# 默认本地调试：不调用真实模型
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# OpenAI 或 OpenAI 兼容网关
# 示例：
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=<你的密钥>
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# 若云厂商提供 OpenAI 兼容接口，保持 LLM_PROVIDER=openai，
# 并修改 OPENAI_BASE_URL 与 LLM_MODEL。
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 出题阶段 RAG（岗位知识库）
# ------------------------------------------------------------------------------
# 开启后，出题阶段会从 Milvus Lite 检索岗位相关知识，再生成面试题。
#
# 步骤：
# 1. 填写下方配置。
# 2. 将岗位知识 markdown 放到 backend/knowledge/roles/。
# 3. 执行: python3 scripts/index_role_knowledge.py
# ------------------------------------------------------------------------------
RAG_ENABLED=false
RAG_COLLECTION_NAME=role_knowledge
RAG_TOP_K=4
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=hash-embedding-v1
RAG_EMBEDDING_DIMENSION=256
RAG_KNOWLEDGE_DIR=./knowledge
MILVUS_LITE_DB_PATH=./data/milvus_lite.db

# ------------------------------------------------------------------------------
# Claude / Anthropic 或兼容网关
# 示例：
# LLM_PROVIDER=anthropic
# LLM_MODEL=MiniMax-M2.5
# ANTHROPIC_API_KEY=<你的密钥>
# ANTHROPIC_BASE_URL=https://aigw-gzgy2.cucloud.cn:8443
#
# 填写自定义 ANTHROPIC_BASE_URL 时，会用同一 ANTHROPIC_API_KEY 发送 Authorization: Bearer。
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ------------------------------------------------------------------------------
# 火山方舟 / 豆包
# 示例：
# LLM_PROVIDER=volcengine
# LLM_MODEL=doubao-seed-1-6-flash-250715
# VOLCENGINE_API_KEY=<你的密钥>
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ------------------------------------------------------------------------------
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
